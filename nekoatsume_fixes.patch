+# ---------------------------------------------------------------------------
+# 古いセーブデータの移行
+# ---------------------------------------------------------------------------
+def migrate_data(data):
+    """古いセーブデータを現在の形式にそろえる(何度呼んでも結果は同じ)。
+
+    - アイテムのキーを、表示名(日本語)から内部IDに変える
+    - 値段・size・kind・説明などの「定義」を現在のカタログに合わせる
+      (大型キャットハウスの size 7 → 6 もここで既存セーブに反映される)
+    - 遊んでいる猫・庭の中身など「状態」は、そのまま引き継ぐ
+    - 猫が持つ on_toy / fav_toy の参照を、表示名からIDに置き換える
+    - 旧版では大型キャットハウスが置けず、エサ扱いで買われていた。
+      エサとして持っていたおもちゃは、おもちゃとして持ち物に戻す
+    """
+    catalog = {}
+    build_items({"items": catalog})
+    ids_by_name = {item["name"]: item_id for item_id, item in catalog.items()}
+
+    def to_id(ref):
+        """表示名またはIDを、IDにして返す(どちらでもなければそのまま)。"""
+        if ref in catalog:
+            return ref
+        return ids_by_name.get(ref, ref)
+
+    def refresh(entry, fresh):
+        """定義に当たる項目だけ最新にする(occupant などの状態には触らない)。"""
+        for key in ("id", "name", "cost", "currency", "description", "size", "kind"):
+            entry[key] = fresh[key]
+
+    # items: キーをIDにそろえる
+    old_items = data.get("items", {})
+    items = {}
+    for item_id, fresh in catalog.items():
+        old = old_items.get(item_id) or old_items.get(fresh["name"]) or {}
+        merged = dict(fresh)
+        for key in ("attributes", "occupant", "occupied", "in_yard"):
+            if key in old:
+                merged[key] = old[key]
+        items[item_id] = merged
+    data["items"] = items
+
+    # yard: 庭に置いてあるアイテム
+    for entry in data.get("yard", []):
+        item_id = to_id(entry.get("id") or entry.get("name"))
+        entry["id"] = item_id
+        if item_id in catalog:
+            refresh(entry, catalog[item_id])
+
+    # owned_food: 持っているエサ
+    foods = []
+    for entry in data.get("owned_food", []):
+        item_id = to_id(entry.get("id") or entry.get("name"))
+        fresh = catalog.get(item_id)
+        if fresh is None:
+            foods.append(entry)
+        elif fresh["kind"] == "toy":
+            items[item_id]["attributes"] = ["owned"]
+        else:
+            refresh(entry, fresh)
+            foods.append(entry)
+    data["owned_food"] = foods
+
+    # cats: おもちゃへの参照をIDにする
+    for cat in data.get("cats", {}).values():
+        if isinstance(cat, dict):
+            for key in ("on_toy", "fav_toy"):
+                if cat.get(key):
+                    cat[key] = to_id(cat[key])
+    return data
